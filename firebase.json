{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "scripts/**",
      "SPEC.md",
      "README.md",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/@(sw.js|rate.json|index.html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
